# ==============================================================================
# SUPABASE CLOUD DATABASE CONFIGURATION
# ==============================================================================
# Create a free project at https://supabase.com
# Find these credentials in Project Settings -> API:
# 1. Project URL (e.g. https://xyzcompany.supabase.co)
# 2. anon/public API key or service_role key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for admin operations bypassing RLS (keep private)
SUPABASE_SERVICE_ROLE_KEY=

# Server Port
PORT=3000
